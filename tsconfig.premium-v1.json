{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".premium-v1-build",
    "strict": true,
    "noEmit": false,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "src/premium/v1/**/*.ts",
    "src/types/PremiumGameplayRuntime.ts",
    "src/types/PremiumGameplay.ts",
    "src/types/GameRuntime.ts",
    "src/types/Game.ts",
    "src/types/Puzzle.ts",
    "src/types/LearningContent.ts",
    "src/types/**/*.ts",
    "src/game/runtime/**/*.ts",
    "src/game/engine/**/*.ts",
    "src/services/AdaptiveHintRuntime.ts",
    "src/services/AccessibilityRuntime.ts",
    "src/services/GameplayFeedbackRuntime.ts",
    "src/services/PracticeGenerator.ts",
    "src/services/PremiumDailyChallenge.ts",
    "src/services/PlayerProfileStatistics.ts",
    "src/services/PuzzleLibrary.ts",
    "src/services/DailyChallenge.ts",
    "tools/tests/premium-gameplay-v1.test.ts"
  ]
}