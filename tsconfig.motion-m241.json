{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "outDir": ".motion-m241-build",
    "rootDir": ".",
    "declaration": false
  },
  "include": [
    "src/ui/motion/types.ts",
    "src/ui/motion/preferences.ts",
    "src/ui/motion/tokens.ts",
    "src/ui/motion/animations.ts",
    "src/ui/motion/transitions.ts",
    "src/ui/motion/persistence.ts",
    "tools/tests/motion-system-m241.test.ts"
  ],
  "exclude": [
    "node_modules",
    ".motion-m241-build"
  ]
}
