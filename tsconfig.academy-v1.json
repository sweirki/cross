{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".academy-v1-build",
    "strict": true,
    "noEmit": false,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "src/academy/v1/**/*.ts",
    "src/types/AdaptiveLearningRuntime.ts",
    "tools/tests/adaptive-learning-v1.test.ts"
  ]
}
