{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".game-v1-build",
    "strict": true,
    "noEmit": false,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "src/engine/math/**/*.ts",
    "src/game/engine/**/*.ts",
    "src/game/runtime/**/*.ts",
    "src/game/solver/**/*.ts",
    "src/game/validation/PuzzleValidation.ts",
    "src/types/Cell.ts",
    "src/types/Difficulty.ts",
    "src/types/Equation.ts",
    "src/types/Game.ts",
    "src/types/GameRuntime.ts",
    "src/types/Operator.ts",
    "src/types/Position.ts",
    "src/types/Puzzle.ts",
    "src/types/Solver.ts",
    "src/types/RuntimeContent.ts",
    "tools/tests/game-runtime-v1.test.ts"
  ]
}
