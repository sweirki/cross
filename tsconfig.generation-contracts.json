{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": ".generation-contracts-build",
    "strict": true,
    "noEmit": false,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "src/generation/**/*.ts",
    "src/engine/random/DeterministicRandom.ts",
    "src/types/Difficulty.ts",
    "src/types/Operator.ts",
    "src/types/Position.ts",
    "tools/tests/commercial-generation-contracts.test.ts",
    "tools/tests/production-cluster-library.test.ts",
    "tools/tests/composition-engine.test.ts",
    "tools/tests/structural-dependency-graph.test.ts",
    "tools/tests/equation-filling-v2.test.ts",
    "tools/tests/clue-planning-deduction.test.ts",
    "tools/tests/unified-certification.test.ts",
    "tools/tests/industrial-generation-v2.test.ts",
    "tools/tests/puzzle-studio-v2.test.ts",
    "src/types/Cell.ts",
    "src/types/Equation.ts",
    "src/types/Puzzle.ts",
    "src/types/Topology.ts",
    "src/generation/content/**/*.ts",
    "tools/tests/certified-content-pipeline.test.ts",
    "src/types/RuntimeContent.ts",
    "src/services/PuzzleLibrary.ts",
    "src/generation/hints/**/*.ts",
    "src/generation/telemetry/**/*.ts",
    "tools/tests/hint-ai-telemetry.test.ts",
    "src/generation/release/**/*.ts",
    "tools/tests/release-hardening.test.ts",
    "src/data/generated/**/*.ts",
    "src/data/bundledLibrary.ts",
    "src/data/commercialPuzzles.ts",
    "src/data/BoardCompositionEngine.ts",
    "src/data/demoPuzzle.ts",
    "src/data/tutorialPuzzles.ts",
    "tools/tests/generator-cutover.test.ts",
    "tools/tests/generator-tuning-phase13a.test.ts"
  ]
}
